    "expectedField": "stay.checkOut",
    "body": {"guest": {"firstName": "InWon", "lastName": "Case021"}, "stay": {"checkIn": "2026-12-01", "checkOut": "2026-12-01"}, "price": 50000, "deposit": true, "request": "Breakfast"}
  },
