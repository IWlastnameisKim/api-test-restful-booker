[
  {
    "id": "SVC-CASE-001",
    "case": "[정상] 모든 필드 정상",
    "purpose": "정상 요청은 201로 생성되고, 중계 기록에 예약 API 호출 1건이 남는지 확인 (기록 방식이 동작한다는 대조군)",
    "expectedStatus": 201,
    "body": {"guest": {"firstName": "InWon", "lastName": "Case001"}, "stay": {"checkIn": "2026-12-01", "checkOut": "2026-12-03"}, "price": 50000, "deposit": true, "request": "Breakfast"}
  },
  {
    "id": "SVC-CASE-002",
    "case": "[누락] guest",
    "purpose": "guest 객체가 없으면 거절되고 예약 API를 호출하지 않는지 확인",
    "expectedStatus": 400,
    "expectedField": "guest.firstName",
    "note": "상위 객체 누락은 첫 하위 필드(guest.firstName)에서 걸림",
    "body": {"stay": {"checkIn": "2026-12-01", "checkOut": "2026-12-03"}, "price": 50000, "deposit": true, "request": "Breakfast"}
  },
  {
    "id": "SVC-CASE-003",
    "case": "[누락] guest.firstName",
    "purpose": "firstName이 없으면 거절되는지 확인",
    "expectedStatus": 400,
    "expectedField": "guest.firstName",
    "body": {"guest": {"lastName": "Case003"}, "stay": {"checkIn": "2026-12-01", "checkOut": "2026-12-03"}, "price": 50000, "deposit": true, "request": "Breakfast"}
  },
  {
    "id": "SVC-CASE-004",
    "case": "[누락] guest.lastName",
    "purpose": "lastName이 없으면 거절되는지 확인",
    "expectedStatus": 400,
    "expectedField": "guest.lastName",
    "body": {"guest": {"firstName": "InWon"}, "stay": {"checkIn": "2026-12-01", "checkOut": "2026-12-03"}, "price": 50000, "deposit": true, "request": "Breakfast"}
  },
  {
    "id": "SVC-CASE-005",
    "case": "[누락] stay",
    "purpose": "stay 객체가 없으면 거절되는지 확인",
    "expectedStatus": 400,
    "expectedField": "stay.checkIn",
    "note": "상위 객체 누락은 첫 하위 필드(stay.checkIn)에서 걸림",
    "body": {"guest": {"firstName": "InWon", "lastName": "Case005"}, "price": 50000, "deposit": true, "request": "Breakfast"}
  },
  {
    "id": "SVC-CASE-006",
    "case": "[누락] stay.checkIn",
    "purpose": "checkIn이 없으면 거절되는지 확인",
    "expectedStatus": 400,
    "expectedField": "stay.checkIn",
    "body": {"guest": {"firstName": "InWon", "lastName": "Case006"}, "stay": {"checkOut": "2026-12-03"}, "price": 50000, "deposit": true, "request": "Breakfast"}
  },
  {
    "id": "SVC-CASE-007",
    "case": "[누락] stay.checkOut",
    "purpose": "checkOut이 없으면 거절되는지 확인",
    "expectedStatus": 400,
    "expectedField": "stay.checkOut",
    "body": {"guest": {"firstName": "InWon", "lastName": "Case007"}, "stay": {"checkIn": "2026-12-01"}, "price": 50000, "deposit": true, "request": "Breakfast"}
  },
  {
    "id": "SVC-CASE-008",
    "case": "[누락] price",
    "purpose": "price가 없으면 거절되는지 확인",
    "expectedStatus": 400,
    "expectedField": "price",
    "body": {"guest": {"firstName": "InWon", "lastName": "Case008"}, "stay": {"checkIn": "2026-12-01", "checkOut": "2026-12-03"}, "deposit": true, "request": "Breakfast"}
  },
  {
    "id": "SVC-CASE-009",
    "case": "[누락] deposit",
    "purpose": "deposit이 없으면 거절되는지 확인",
    "expectedStatus": 400,
    "expectedField": "deposit",
    "body": {"guest": {"firstName": "InWon", "lastName": "Case009"}, "stay": {"checkIn": "2026-12-01", "checkOut": "2026-12-03"}, "price": 50000, "request": "Breakfast"}
  },
  {
    "id": "SVC-CASE-010",
    "case": "[누락] request (선택 필드)",
    "purpose": "선택 필드 request가 없어도 생성되고, 예약 API에 additionalneeds를 보내지 않는지 확인",
    "expectedStatus": 201,
    "body": {"guest": {"firstName": "InWon", "lastName": "Case010"}, "stay": {"checkIn": "2026-12-01", "checkOut": "2026-12-03"}, "price": 50000, "deposit": true}
  },
  {
    "id": "SVC-CASE-011",
    "case": "[누락] 모든 필드",
    "purpose": "빈 객체는 거절되고, 검증 순서의 첫 필드(guest.firstName)를 알려 주는지 확인",
    "expectedStatus": 400,
    "expectedField": "guest.firstName",
    "body": {}
  },
  {
    "id": "SVC-CASE-012",
    "case": "[경계] firstName 1글자",
    "purpose": "비어 있지 않은 문자열의 최소 길이인 1글자로 생성되는지 확인",
    "expectedStatus": 201,
    "body": {"guest": {"firstName": "A", "lastName": "Case012"}, "stay": {"checkIn": "2026-12-01", "checkOut": "2026-12-03"}, "price": 50000, "deposit": true, "request": "Breakfast"}
  },
  {
    "id": "SVC-CASE-013",
    "case": "[경계] firstName 빈 문자열",
    "purpose": "빈 문자열 이름이 거절되는지 확인 (누락과 별개)",
    "expectedStatus": 400,
    "expectedField": "guest.firstName",
    "body": {"guest": {"firstName": "", "lastName": "Case013"}, "stay": {"checkIn": "2026-12-01", "checkOut": "2026-12-03"}, "price": 50000, "deposit": true, "request": "Breakfast"}
  },
  {
    "id": "SVC-CASE-014",
    "case": "[경계] firstName 공백만",
    "purpose": "공백만 있는 이름이 빈 이름으로 거절되는지 확인",
    "expectedStatus": 400,
    "expectedField": "guest.firstName",
    "body": {"guest": {"firstName": "  ", "lastName": "Case014"}, "stay": {"checkIn": "2026-12-01", "checkOut": "2026-12-03"}, "price": 50000, "deposit": true, "request": "Breakfast"}
  },
  {
    "id": "SVC-CASE-015",
    "case": "[경계] lastName 빈 문자열",
    "purpose": "빈 문자열 성이 거절되는지 확인",
    "expectedStatus": 400,
    "expectedField": "guest.lastName",
    "body": {"guest": {"firstName": "InWon", "lastName": ""}, "stay": {"checkIn": "2026-12-01", "checkOut": "2026-12-03"}, "price": 50000, "deposit": true, "request": "Breakfast"}
  },
  {
    "id": "SVC-CASE-016",
    "case": "[타입] firstName 숫자",
    "purpose": "문자열이 아닌 숫자 이름이 거절되는지 확인",
    "expectedStatus": 400,
    "expectedField": "guest.firstName",
    "body": {"guest": {"firstName": 123, "lastName": "Case016"}, "stay": {"checkIn": "2026-12-01", "checkOut": "2026-12-03"}, "price": 50000, "deposit": true, "request": "Breakfast"}
  },
  {
    "id": "SVC-CASE-017",
    "case": "[타입] firstName null",
    "purpose": "null 이름이 거절되는지 확인",
    "expectedStatus": 400,
    "expectedField": "guest.firstName",
    "body": {"guest": {"firstName": null, "lastName": "Case017"}, "stay": {"checkIn": "2026-12-01", "checkOut": "2026-12-03"}, "price": 50000, "deposit": true, "request": "Breakfast"}
  },
  {
    "id": "SVC-CASE-018",
    "case": "[타입] guest가 문자열",
    "purpose": "guest가 객체가 아니라 문자열이면 거절되는지 확인",
    "expectedStatus": 400,
    "expectedField": "guest.firstName",
    "body": {"guest": "InWon Kim", "stay": {"checkIn": "2026-12-01", "checkOut": "2026-12-03"}, "price": 50000, "deposit": true, "request": "Breakfast"}
