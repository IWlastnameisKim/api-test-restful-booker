    "case": "[경계] 1박",
    "purpose": "숙박 기간의 최소값인 1박(checkOut = checkIn + 1일)으로 생성되는지 확인",
    "expectedStatus": 201,
    "body": {"guest": {"firstName": "InWon", "lastName": "Case020"}, "stay": {"checkIn": "2026-12-01", "checkOut": "2026-12-02"}, "price": 50000, "deposit": true, "request": "Breakfast"}
