  {
    "id": "SVC-CASE-019",
    "case": "[경계] firstName 앞뒤 공백",
    "purpose": "앞뒤 공백이 있는 이름이 통과하고, 공백을 제거한 값으로 저장·응답되는지 확인",
    "expectedStatus": 201,
    "note": "공백 제거는 Restful-booker가 수행. 서비스는 받은 값을 그대로 전달함",
    "body": {"guest": {"firstName": " InWon ", "lastName": "Case019"}, "stay": {"checkIn": "2026-12-01", "checkOut": "2026-12-03"}, "price": 50000, "deposit": true, "request": "Breakfast"},
    "expectedBody": {"guest": {"firstName": "InWon", "lastName": "Case019"}, "stay": {"checkIn": "2026-12-01", "checkOut": "2026-12-03"}, "price": 50000, "deposit": true, "request": "Breakfast"}
  },
