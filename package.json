{
  "name": "api-test-restful-booker",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test:smoke": "newman run collections/Restful-booker.postman_collection.json -e env/restful-booker.postman_environment.json --folder 01-Setup --folder 02-Flow --folder 04-CleanUp -r cli,htmlextra --reporter-htmlextra-export reports/smoke.html --reporter-htmlextra-logs",
    "test:regression": "newman run collections/Restful-booker.postman_collection.json -e env/restful-booker.postman_environment.json --folder 01-Setup --folder 03-Regression --folder 04-CleanUp --folder 05-Regression-Delete -r cli,htmlextra --reporter-htmlextra-export reports/regression.html --reporter-htmlextra-logs",
    "test:api": "npm run test:smoke && npm run test:regression",
    "test:data": "newman run collections/Restful-booker.postman_collection.json -e env/restful-booker.postman_environment.json --folder 06-Data-Driven -d data/booking-cases.json -r cli,htmlextra --reporter-htmlextra-export reports/data.html --reporter-htmlextra-logs"
  },
  "keywords": [],
  "type": "commonjs",
  "devDependencies": {
    "newman": "^6.2.3",
    "newman-reporter-htmlextra": "^1.23.1"
  }
}
