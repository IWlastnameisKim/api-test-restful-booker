              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const booking=pm.response.json();\nconsole.log(booking.bookingdates.checkin)\n\npm.test(\"상태코드는 200\", () => {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"totalprice 숫자형 여부\", () => {\n    pm.expect(typeof booking.totalprice).to.eql(\"number\");\n});\n\n\npm.test(\"depositpaid는 boolean\", () => {\n    pm.expect(typeof booking.depositpaid).to.eql(\"boolean\");\n});\n\npm.test(\"checkout은 checkin보다 이후\",() =>{\n    pm.expect(booking.bookingdates.checkin < booking.bookingdates.checkout).to.eql(true);\n});"
                ]
              }
            }
          ],
