      "name": "01-Setup",
      "item": [
        {
          "name": "Auth - 토큰 발급",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();\n\npm.test(\"인증토큰발급\", () => {\n  pm.response.to.have.status(200);\n  pm.expect(typeof body.token).to.eql(\"string\");\n});\n\nif (pm.response.code === 200 && typeof body.token === \"string\") {\n  pm.environment.set(\"token\", body.token);\n} else {\n  console.log(\"토큰발급 실패하여 기존 토큰 유지\", body);\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n\"username\" : \"admin\",\n\"password\" : \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            }
          },
          "response": []
        },
        {
          "name": "{{baseUrl}}/booking - 예약생성",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"[Setup] 예약 생성\", () => {\n  pm.expect(pm.response.code).to.eql(200);\n});\n\nif (pm.response.code === 200) {\n  const body = pm.response.json();\n\n  if (typeof body.bookingid === \"number\") {\n    pm.environment.set(\"bookingid\", body.bookingid);\n  } else {\n    console.log(\"[Setup] 예약 생성 - bookingid 없음\", body);\n  }\n} else {\n  console.log(\"[Setup] 예약 생성 실패\", pm.response.code, pm.response.text());\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstname\" : \"Jim\",\n    \"lastname\" : \"Brown\",\n    \"totalprice\" : 111,\n    \"depositpaid\" : true,\n    \"bookingdates\" : {\n        \"checkin\" : \"2018-01-01\",\n        \"checkout\" : \"2019-01-01\"\n    },\n    \"additionalneeds\" : \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            }
          },
          "response": []
        }
      ]
